{
  "name": "agent-workflow",
  "version": "0.2.0",
  "private": true,
  "description": "Explicit Pair and Delegate session workflows for Claude Code, Codex, and Pi",
  "type": "module",
  "engines": { "node": ">=20" },
  "keywords": ["pi-package", "workflow", "pair", "delegate"],
  "pi": { "extensions": ["./adapters/pi/extension.js"], "skills": [], "prompts": [], "themes": [] },
  "files": ["core/", "workflows/", "adapters/", "skills/", "hooks/", ".claude-plugin/", ".codex-plugin/", "docs/", "README.md"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "validate:claude": "claude plugin validate .claude-plugin/plugin.json --strict && claude plugin validate .claude-plugin/marketplace.json --strict",
    "smoke:claude": "node scripts/smoke-claude.mjs",
    "smoke:pi": "node scripts/smoke-pi.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "package": "node scripts/package.mjs"
  }
}
